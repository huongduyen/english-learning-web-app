# Backend Application Port
PORT=3000

# PostgreSQL Connection String (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/english_learning_db?schema=public"

# CORS Configuration (comma-separated origins)
CORS_ORIGIN="http://localhost:5173,http://localhost:80,http://127.0.0.1:5173,http://127.0.0.1"

# JWT Authentication Configuration
JWT_SECRET="your-super-secret-jwt-access-key"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key"
JWT_REFRESH_EXPIRATION="7d"
