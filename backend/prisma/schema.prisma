// Prisma Schema for English Learning Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================
// Enums
// ==============================================

enum UserRole {
  ADMIN
  TEACHER
  LEARNER
}

enum EnglishLevel {
  BEGINNER           // CEFR A1
  ELEMENTARY         // CEFR A2
  INTERMEDIATE       // CEFR B1
  UPPER_INTERMEDIATE // CEFR B2
  ADVANCED           // CEFR C1
  PROFICIENT         // CEFR C2
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum VocabularyStatus {
  NEW
  LEARNING
  REVIEWING
  MASTERED
}

enum ActivityType {
  VOCABULARY
  GRAMMAR
  LISTENING
  READING
  QUIZ
  CONVERSATION
  SPEAKING
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_BLANK
  MATCHING
  TRUE_FALSE
  SENTENCE_ORDERING
  SENTENCE_CORRECTION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ==============================================
// User & Profile
// ==============================================

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  name               String?
  avatar             String?
  role               UserRole           @default(LEARNER)
  level              EnglishLevel       @default(BEGINNER)
  password           String
  hashedRefreshToken String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  profile            UserProfile?
  userVocabularies   UserVocabulary[]
  quizAttempts       QuizAttempt[]
  learningActivities LearningActivity[]
  dailyGoals         DailyGoal[]
  userAchievements   UserAchievement[]
  conversations      Conversation[]

  @@index([email])
  @@map("users")
}

model UserProfile {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetLevel      EnglishLevel @default(INTERMEDIATE)
  nativeLanguage   String       @default("vi")
  dailyGoalMinutes Int          @default(15)
  streakDays       Int          @default(0)
  totalXp          Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("user_profiles")
}

// ==============================================
// Vocabulary Modules
// ==============================================

model VocabularyTopic {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String
  titleVi     String
  description String?
  thumbnail   String?
  level       EnglishLevel   @default(BEGINNER)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  vocabularies Vocabulary[]

  @@index([slug])
  @@index([level])
  @@map("vocabulary_topics")
}

model Vocabulary {
  id                 String           @id @default(uuid())
  topicId            String
  word               String
  phonetic           String?          // IPA: e.g. "/həˈləʊ/"
  partOfSpeech       String?          // noun, verb, adjective, etc.
  meaning            String           // English explanation
  meaningVi          String           // Vietnamese meaning
  exampleSentence    String?          // English sample sentence
  exampleSentenceVi  String?          // Vietnamese translated sentence
  audioUrl           String?
  imageUrl           String?
  difficulty         Difficulty       @default(EASY)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  topic              VocabularyTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userVocabularies   UserVocabulary[]

  @@index([word])
  @@index([topicId])
  @@index([difficulty])
  @@map("vocabularies")
}

model UserVocabulary {
  id             String           @id @default(uuid())
  userId         String
  vocabularyId   String
  status         VocabularyStatus @default(NEW)
  reviewCount    Int              @default(0)
  masteryScore   Int              @default(0) // 0 to 100
  isFavorite     Boolean          @default(false)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary     Vocabulary       @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId])
  @@index([status])
  @@map("user_vocabularies")
}

// ==============================================
// Grammar Modules
// ==============================================

model GrammarLesson {
  id        String            @id @default(uuid())
  slug      String            @unique
  title     String
  titleVi   String
  category  String            @default("Basic Grammar")
  categoryVi String?
  summary   String?
  content   String            @db.Text
  level     EnglishLevel      @default(BEGINNER)
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  exercises GrammarExercise[]
  quiz      Quiz?

  @@index([slug])
  @@index([level])
  @@index([category])
  @@map("grammar_lessons")
}

model GrammarExercise {
  id            String        @id @default(uuid())
  lessonId      String
  instruction   String
  question      String
  questionType  QuestionType  @default(FILL_BLANK)
  options       Json?         // Array of choices for multiple choice / matching
  correctAnswer String
  explanation   String?       // English explanation
  explanationVi String?       // Vietnamese explanation
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lesson        GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("grammar_exercises")
}

// ==============================================
// Listening & Reading Modules
// ==============================================

model ListeningLesson {
  id           String       @id @default(uuid())
  slug         String       @unique
  title        String
  titleVi      String
  description  String?
  audioUrl     String
  duration     Int?         // Duration in seconds
  transcript   String       @db.Text
  transcriptVi String?      @db.Text
  level        EnglishLevel @default(BEGINNER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  quiz         Quiz?

  @@index([slug])
  @@index([level])
  @@map("listening_lessons")
}

model ReadingArticle {
  id          String       @id @default(uuid())
  slug        String       @unique
  title       String
  titleVi     String
  summary     String?
  content     String       @db.Text
  contentVi   String?      @db.Text
  level       EnglishLevel @default(BEGINNER)
  readingTime Int?         // Estimated minutes to read
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  quiz        Quiz?

  @@index([slug])
  @@index([level])
  @@map("reading_articles")
}

// ==============================================
// Quizzes & Assessments
// ==============================================

model Quiz {
  id                String           @id @default(uuid())
  title             String
  description       String?
  level             EnglishLevel     @default(BEGINNER)
  difficulty        Difficulty       @default(EASY)
  timeLimit         Int?             // In minutes
  passingScore      Int              @default(70) // percentage
  listeningLessonId String?          @unique
  readingArticleId  String?          @unique
  grammarLessonId   String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  listeningLesson   ListeningLesson? @relation(fields: [listeningLessonId], references: [id], onDelete: SetNull)
  readingArticle    ReadingArticle?  @relation(fields: [readingArticleId], references: [id], onDelete: SetNull)
  grammarLesson     GrammarLesson?   @relation(fields: [grammarLessonId], references: [id], onDelete: SetNull)
  questions         Question[]
  attempts          QuizAttempt[]

  @@index([level])
  @@index([difficulty])
  @@map("quizzes")
}

model Question {
  id            String       @id @default(uuid())
  quizId        String
  prompt        String
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  options       Json         // Options list: [{ id: "a", text: "..." }]
  correctAnswer String       // E.g. "a" or the correct text
  explanation   String?
  explanationVi String?
  order         Int          @default(0)
  points        Int          @default(10)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("questions")
}

model QuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  quizId      String
  score       Float
  maxScore    Float
  percentage  Float
  passed      Boolean   @default(false)
  answers     Json?     // User submitted answers
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@index([createdAt])
  @@map("quiz_attempts")
}

// ==============================================
// Progress Tracking & Goals
// ==============================================

model LearningActivity {
  id              String       @id @default(uuid())
  userId          String
  type            ActivityType
  referenceId     String?      // ID of lesson, quiz, topic, etc.
  durationMinutes Int          @default(0)
  score           Float?
  metadata        Json?        // Additional details e.g. { correct: 8, total: 10 }
  createdAt       DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("learning_activities")
}

model DailyGoal {
  id            String   @id @default(uuid())
  userId        String
  date          DateTime @db.Date
  targetMinutes Int      @default(15)
  actualMinutes Int      @default(0)
  targetWords   Int      @default(5)
  actualWords   Int      @default(0)
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_goals")
}

// ==============================================
// Gamification & Achievements
// ==============================================

model Achievement {
  id            String            @id @default(uuid())
  code          String            @unique
  title         String
  titleVi       String
  description   String
  descriptionVi String
  icon          String?
  points        Int               @default(50)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  userAchievements UserAchievement[]

  @@index([code])
  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  progress      Float       @default(100) // Percentage toward completion

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ==============================================
// AI Conversation Practice
// ==============================================

model Conversation {
  id        String                @id @default(uuid())
  userId    String
  title     String                @default("New Conversation")
  topic     String?
  scenario  String?
  level     EnglishLevel          @default(BEGINNER)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]

  @@index([userId])
  @@index([createdAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String       @db.Text
  feedback       Json?        // Suggestions, pronunciation or grammar feedback
  audioUrl       String?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("conversation_messages")
}
